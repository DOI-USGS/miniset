#!/bin/sh
CONFIG_LIBS="-L/Users/krodriguez/repos/knoten/miniset/external/gdal-install/lib -lgdal -L/Users/krodriguez/miniforge3/envs/miniset/lib/emscripten-3.1.58/cache/sysroot/lib/wasm32-emscripten -L/Users/krodriguez/repos/knoten/miniset/external/proj-install/lib -lz -lproj"
CONFIG_DEP_LIBS=""
CONFIG_PREFIX="/Users/krodriguez/repos/knoten/miniset/external/gdal-install"
CONFIG_CFLAGS="-I/Users/krodriguez/repos/knoten/miniset/external/gdal-install/include"
CONFIG_DATA="/Users/krodriguez/repos/knoten/miniset/external/gdal-install/share/gdal"
CONFIG_VERSION="3.8.5dev"
CONFIG_GNM_ENABLED=yes
CONFIG_FORMATS="GTIFF MEM vrt Derived HFA MEM geojson TAB Shape KML VRT"
CONFIG_PLUGINDIR="/Users/krodriguez/repos/knoten/miniset/external/gdal-install/lib/gdalplugins"
usage()

{
	cat <<EOF
Usage: gdal-config [OPTIONS]
Options:
	[--prefix[=DIR]]
	[--libs]
	[--dep-libs]
	[--cflags]
	[--datadir]
	[--version]
	[--ogr-enabled]
	[--gnm-enabled]
	[--formats]
	[--plugindir]
EOF
	exit $1
}

if test $# -eq 0; then
	usage 1 1>&2
fi

case $1 in
  --libs)
    echo $CONFIG_LIBS
    ;;

  --dep-libs)
    echo $CONFIG_DEP_LIBS
    ;;

  --cflags)
    echo $CONFIG_CFLAGS
    ;;

  --datadir)
    echo $CONFIG_DATA
    ;;

  --prefix)
    echo $CONFIG_PREFIX
    ;;

  --version)
    echo $CONFIG_VERSION
    ;;

  --ogr-enabled)
    echo yes
    ;;

  --gnm-enabled)
    echo $CONFIG_GNM_ENABLED
    ;;

  --formats)
    echo $CONFIG_FORMATS
    ;;

  --plugindir)
    echo $CONFIG_PLUGINDIR
    ;;

  *)
    usage 1 1>&2
    ;;

esac
